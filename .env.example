# Use demo mode before connecting paid external services.
AGENT_MODE=demo
SEARCH_MODE=keyword
DATABASE_PATH=./data/capstone.sqlite3
DEMO_ADMIN_KEY=replace-with-your-private-random-secret
# Optional separate HMAC key for short-lived MCP write approvals.
# If empty, local demo uses DEMO_ADMIN_KEY. Never commit real secrets.
MCP_APPROVAL_SIGNING_KEY=
OPENAI_MODEL=replace-with-an-available-model
OPENAI_API_KEY=
QDRANT_URL=http://localhost:6333
DATABASE_URL=postgresql://demo:demo@localhost:5432/agentdb
LANGSMITH_TRACING=false
